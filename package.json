{
  "name": "global-readonly",
  "displayName": "Global Readonly",
  "description": "One-click toggle for making the entire workspace read-only, powered by VS Code's built-in files.readonlyInclude feature.",
  "version": "0.0.5",
  "publisher": "tiramission",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kain-jiang/global-readonly.git"
  },
  "homepage": "https://github.com/kain-jiang/global-readonly#readme",
  "bugs": {
    "url": "https://github.com/kain-jiang/global-readonly/issues"
  },
  "keywords": [
    "readonly",
    "read-only",
    "readonlyInclude",
    "lock",
    "protect",
    "workspace"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.77.0"
  },
  "packageManager": "bun@1.3.14",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "globalReadonly.enable",
        "title": "Global Readonly: Enable",
        "category": "Global Readonly",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "globalReadonly.disable",
        "title": "Global Readonly: Disable",
        "category": "Global Readonly",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "globalReadonly.toggle",
        "title": "Global Readonly: Toggle",
        "category": "Global Readonly",
        "enablement": "workspaceFolderCount > 0"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "globalReadonly.enable",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "globalReadonly.disable",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "globalReadonly.toggle",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "Global Readonly",
      "properties": {
        "globalReadonly.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item that displays the read-only state and toggles it on click."
        }
      }
    }
  },
  "scripts": {
    "test": "node ./test/runTest.js",
    "package": "vsce package",
    "vscode:prepublish": "node -e \"console.log('no build required')\""
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.3.2",
    "mocha": "^10.7.3"
  }
}
